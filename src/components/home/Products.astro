---
import wave from '@/assets/decor/graphs-reinsurance.svg'
import LineGrid from '@/components/ui/LineGrid.astro'
import ShadeGrid from '@/components/ui/ShadeGrid.astro'
import Tag from '@/components/ui/Tag.astro'
import { products } from '@/data/products'
---

<section
  id="products"
  class="section products"
  aria-labelledby="products-title"
>
  <h2
    class="visually-hidden"
    id="products-title"
  >
    Products
  </h2>
  <div class="products__grid">
    {products.map((product) => (
      <a
        class="product card"
        href={product.href}
        data-theme="yelbolt"
        data-mode-base={product.modeBase}
        data-mode={`${product.modeBase}-light`}
        aria-labelledby={`product-${product.id}`}
      >
        <div
          class="product__visual"
          aria-hidden="true"
        >
          {product.visual === 'shades' ? (
            <ShadeGrid
              class="product__shades"
              wave={{ src: wave, inset: '0 -5.19% -2.73% -5.19%' }}
              cols={12}
              rows={6}
              areas={[]}
            />
          ) : (
            <LineGrid
              class="product__lines"
              count={36}
            />
          )}
        </div>
        <div class="product__info">
          <Tag>{product.tag}</Tag>
          <h3
            class="t-paragraph-secondary-title"
            id={`product-${product.id}`}
          >
            {product.name}
          </h3>
          <p class="t-accent">{product.text}</p>
          <span
            class="product__more"
            aria-hidden="true"
          >
            Get started
          </span>
        </div>
      </a>
    ))}
  </div>
  <!-- Before paint: the cards wear their product's mode in the page's scheme. -->
  <script is:inline>
    for (const card of document.querySelectorAll('[data-mode-base]'))
      card.dataset.mode = `${card.dataset.modeBase}-${document.documentElement.dataset.scheme || 'light'}`
  </script>
</section>

<style>
  .products {
    padding-top: var(--layout-gutter);
  }

  .products__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-gap-200);
  }

  /* The card wears its product's mode: colours come from the roles declared
     on [data-mode], not from the root-resolved component tokens. */
  .product {
    --card-background-color-default: var(--site-surface);
    --card-background-color-hover: var(--site-surface);
    --card-border-color-default: var(--site-border-strong);
    --card-border-color-hover: var(--site-border-strong);
    display: flex;
    flex-direction: column;
    min-height: 712px;
    color: var(--site-ink);
    text-decoration: none;
  }

  /* UI Color Palette keeps its brand gradient (Figma "UICP GRD") under the
     shades, as on ui-color-palette.com: allowed exception. */
  .product[data-mode-base='yelbolt-uicp'] {
    --brand-gradient: linear-gradient(
      90deg,
      #ff0000,
      #ffb800 20%,
      #24ff00 40%,
      #00d1ff 60%,
      #4200ff 80%,
      #ff0000
    );
  }

  .product__visual {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    padding: var(--space-inset-200) var(--space-inset-200) 0;
    min-height: 320px;
  }

  .product__visual > :global(*) {
    flex: 1 1 auto;
  }

  .product__visual :global(.product__shades) {
    --shade-row-min: 40px;
  }

  .product__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-gap-400);
    padding: var(--space-inset-800);
  }

  .product :global(.tag) {
    background-color: transparent;
  }

  .product__more {
    display: flex;
    justify-content: center;
    align-items: center;
    align-self: stretch;
    border-radius: var(--site-radius-pill);
    background-color: var(--color-background-brand-default);
    height: var(--control-size-1200);
    color: var(--color-text-on-brand-default);
  }

  .product:hover .product__more {
    background-color: var(--color-background-brand-hover);
  }

  @media (max-width: 1023.98px) {
    .products__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .product {
      min-height: 560px;
    }
  }

  @media (max-width: 639.98px) {
    .product__info {
      padding: var(--space-inset-600);
    }
  }
</style>
